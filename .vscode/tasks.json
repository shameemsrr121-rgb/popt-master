{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug APK",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "windows": {
        "command": ".\\gradlew.bat assembleDebug"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Install and Run App on Device/Emulator",
      "type": "shell",
      "command": "./gradlew installDebug && adb shell am start -n com.aistudio.potracker.xvkqmb/com.example.MainActivity",
      "windows": {
        "command": ".\\gradlew.bat installDebug && adb shell am start -n com.aistudio.potracker.xvkqmb/com.example.MainActivity"
      },
      "group": "build",
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "View Logcat",
      "type": "shell",
      "command": "adb logcat -s POPT:* AndroidRuntime:*",
      "windows": {
        "command": "adb logcat -s POPT:* AndroidRuntime:*"
      },
      "problemMatcher": []
    }
  ]
}
